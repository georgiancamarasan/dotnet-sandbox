@using CultureSandbox.Localization
@using Microsoft.AspNetCore.Localization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CultureSandbox.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" InitialRequest="initialRequest" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // App.razor is always rendered statically over HTTP, so HttpContext is available here (and only here).
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private InitialRequestInfo? initialRequest;

    protected override void OnInitialized()
    {
        if (HttpContext is null) return;

        initialRequest = new InitialRequestInfo(
            CultureInfo.CurrentCulture.Name,
            CultureInfo.CurrentUICulture.Name,
            HttpContext.Features.Get<IRequestCultureFeature>()?.Provider?.GetType().Name,
            HttpContext.Items[UserRequestCultureProvider.UserIdItemKey] as string);
    }
}
